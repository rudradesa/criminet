<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login | Criminet</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;

            font-family: Arial, Helvetica, sans-serif;

            background:
                radial-gradient(circle at top left, #1e293b, transparent 45%),
                radial-gradient(circle at bottom right, #111827, transparent 45%),
                #020617;

            color: #f8fafc;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            padding: 36px;
            border: 1px solid #334155;
            border-radius: 16px;

            background: rgba(15, 23, 42, 0.95);

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.45);
        }

        .logo {
            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 20px;

            border-radius: 14px;

            background: #1e293b;

            font-size: 26px;
            font-weight: bold;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 27px;
        }

        .subtitle {
            margin: 0 0 28px;
            color: #94a3b8;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 8px;

            font-size: 14px;
            font-weight: 600;

            color: #cbd5e1;
        }

        input {
            width: 100%;
            padding: 13px 14px;

            border: 1px solid #475569;
            border-radius: 9px;

            background: #020617;
            color: #f8fafc;

            font-size: 15px;

            outline: none;
        }

        input:focus {
            border-color: #94a3b8;
        }

        button {
            width: 100%;
            padding: 13px;

            border: 0;
            border-radius: 9px;

            background: #f8fafc;
            color: #020617;

            font-size: 15px;
            font-weight: 700;

            cursor: pointer;
        }

        button:hover {
            background: #e2e8f0;
        }

        .error {
            margin-bottom: 20px;
            padding: 12px 14px;

            border: 1px solid #7f1d1d;
            border-radius: 8px;

            background: #450a0a;
            color: #fecaca;

            font-size: 14px;
        }

        .security-note {
            margin-top: 22px;

            text-align: center;

            color: #64748b;
            font-size: 12px;
        }
    </style>
</head>

<body>

<div class="login-container">

    <div class="login-card">

        <div class="logo">
            CI
        </div>

        <h1>Admin Login</h1>

        <p class="subtitle">
            Criminal Intelligence Management System
        </p>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>

        <form method="POST" action="/admin/login">

            <div class="form-group">
                <label for="username">
                    Username
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter username"
                    autocomplete="username"
                    required
                    autofocus
                >
            </div>

            <div class="form-group">
                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter password"
                    autocomplete="current-password"
                    required
                >
            </div>

            <button type="submit">
                Sign In
            </button>

        </form>

        <div class="security-note">
            Authorized personnel only
        </div>

    </div>

</div>

</body>
</html>