if (['VEHICLE', 'PHONE', 'ADDRESS'].includes(type)) {
    const addSuspectButton = document.getElementById('addSuspectButton');

    if (addSuspectButton) {
        addSuspectButton.addEventListener('click', addSuspect);
    }

    loadSuspects().then(() => {
        // Start with one suspect selector after the suspect list is loaded.
        addSuspect();
    });
}

if (type === 'CASE') {
    document.getElementById('addPersonButton')
        .addEventListener('click', addPerson);

    document.getElementById('addLocationButton')
        .addEventListener('click', addLocation);

    document.getElementById('addPhoneButton')
        .addEventListener('click', addPhone);

    document.getElementById('addVehicleButton')
        .addEventListener('click', addVehicle);
}

async function loadRecords() {
    const recordsElement = document.getElementById('records');

    try {
        const response = await fetch('/api/entities/' + type);
        const json = await response.json();

        if (!json.success) {
            recordsElement.textContent =
                json.message || 'Unable to load records.';
            return;
        }

        if (!json.data.length) {
            recordsElement.textContent =
                type === 'CASE'
                    ? 'No cases yet.'
                    : 'No records yet.';
            return;
        }

        if (type !== 'CASE') {
            const idField = type.toLowerCase() + 'Id';
            recordsElement.innerHTML = json.data.map(record => `
                <article class="entity-record">
                    <div class="entity-record-header">
                        <div>
                            <a class="entity-id" href="/entity/${encodeURIComponent(type)}/${encodeURIComponent(record[idField] || '')}">
                                ${escapeHtml(record[idField] || 'Unknown ID')}
                            </a>
                            <h3>${escapeHtml(entityTitle(record, type))}</h3>
                        </div>
                        <a class="small-button" href="/entity/${encodeURIComponent(type)}/${encodeURIComponent(record[idField] || '')}">View details</a>
                    </div>
                    <pre>${escapeHtml(JSON.stringify(record, null, 2))}</pre>
                </article>
            `).join('');
            return;
        }

        recordsElement.innerHTML =
            json.data.map(renderCaseRecord).join('');

    } catch (error) {
        console.error(error);
        recordsElement.textContent = 'Unable to load records.';
    }
}

function entityTitle(record, entityType) {
    if (entityType === 'PERSON') {
        return `${record.firstName || ''} ${record.lastName || ''}`.trim() || 'Person';
    }
    if (entityType === 'VEHICLE') return `${record.make || ''} ${record.model || ''}`.trim() || 'Vehicle';
    if (entityType === 'PHONE') return record.phoneNumber || 'Phone';
    if (entityType === 'ADDRESS') return `${record.addressLine || ''}${record.city ? ', ' + record.city : ''}` || 'Address';
    if (entityType === 'LOCATION') return record.name || 'Location';
    return entityType;
}

function renderCaseRecord(caseData) {
    const casePersons =
        Array.isArray(caseData.persons)
            ? caseData.persons
            : [];

    const caseLocations =
        Array.isArray(caseData.locationIds)
            ? caseData.locationIds
            : [];

    const casePhones =
        Array.isArray(caseData.phoneIds)
            ? caseData.phoneIds
            : [];

    const caseVehicles =
        Array.isArray(caseData.vehicleIds)
            ? caseData.vehicleIds
            : [];

    return `
        <article class="case-record">

            <div class="case-record-header">

                <div>
                    <a class="entity-id" href="/entity/CASE/${encodeURIComponent(caseData.caseId)}">${escapeHtml(caseData.caseId)}</a>

                    <h3>
                        ${escapeHtml(caseData.title)}
                    </h3>
                </div>

                <span class="status-badge">
                    ${escapeHtml(caseData.status || 'UNKNOWN')}
                </span>

            </div>

            ${
                caseData.description
                    ? `<p>${escapeHtml(caseData.description)}</p>`
                    : ''
            }

            <div class="case-meta">

                <span>
                    Type:
                    <strong>
                        ${escapeHtml(caseData.caseType || 'OTHER')}
                    </strong>
                </span>

                <span>
                    Opened:
                    <strong>
                        ${escapeHtml(caseData.openedDate || '—')}
                    </strong>
                </span>

            </div>

            <div class="connection-summary">

                <span>Persons: ${casePersons.length}</span>
                <span>Locations: ${caseLocations.length}</span>
                <span>Phones: ${casePhones.length}</span>
                <span>Vehicles: ${caseVehicles.length}</span>

            </div>

            ${
                casePersons.length
                    ? `
                        <div class="person-list">

                            <strong>Persons Involved</strong>

                            ${casePersons.map(person => `
                                <div class="person-chip">

                                    <span>
                                        ${escapeHtml(person.id)}
                                    </span>

                                    ${
                                        person.name
                                            ? `
                                                <span>
                                                    ${escapeHtml(person.name)}
                                                </span>
                                            `
                                            : ''
                                    }

                                    <span>
                                        ${escapeHtml(
                                            person.role || 'UNKNOWN'
                                        )}
                                    </span>

                                </div>
                            `).join('')}

                        </div>
                    `
                    : ''
            }

        </article>
    `;
}

form.addEventListener('submit', async event => {

    event.preventDefault();

    messageElement.textContent = 'Saving...';
    messageElement.className = 'message';

    try {

        let data;

        if (type === 'CASE') {

            const casePersons = [];

            document
                .querySelectorAll('#personsContainer .person-row')
                .forEach(row => {

                    const id =
                        row.querySelector('.person-id')
                            .value
                            .trim();

                    const role =
                        row.querySelector('.person-role')
                            .value
                            .trim();

                    if (id) {
                        casePersons.push({
                            id,
                            role
                        });
                    }
                });

            const locationIds = [];

            document
                .querySelectorAll('#locationsContainer .location-id')
                .forEach(select => {

                    const id = select.value.trim();

                    if (id) {
                        locationIds.push(id);
                    }
                });

            const phoneIds = [];

            document
                .querySelectorAll('#phonesContainer .phone-id')
                .forEach(select => {

                    const id = select.value.trim();

                    if (id) {
                        phoneIds.push(id);
                    }
                });

            const vehicleIds = [];

            document
                .querySelectorAll('#vehiclesContainer .vehicle-id')
                .forEach(select => {

                    const id = select.value.trim();

                    if (id) {
                        vehicleIds.push(id);
                    }
                });

            const formData = new FormData(form);

            data = {
                title: String(formData.get('title') || '').trim(),

                description:
                    String(formData.get('description') || '').trim(),

                caseType:
                    String(formData.get('caseType') || '').trim(),

                status:
                    String(formData.get('status') || '').trim(),

                openedDate:
                    String(formData.get('openedDate') || '').trim(),

                persons: casePersons,

                locationIds,

                phoneIds,

                vehicleIds
            };

        } else {

            data = Object.fromEntries(
                new FormData(form).entries()
            );

            if (['VEHICLE', 'PHONE', 'ADDRESS'].includes(type)) {
                data.suspectIds = Array.from(
                    document.querySelectorAll(
                        '#suspectsContainer .suspect-id'
                    )
                )
                    .map(select => select.value.trim())
                    .filter(Boolean);
            }

        }

        const response = await fetch(
            '/api/entities/' + type,
            {
                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)
            }
        );

        const json = await response.json();

        if (!response.ok || !json.success) {
            throw new Error(
                json.message || 'Unable to save record.'
            );
        }

        messageElement.textContent =
            json.message || 'Saved successfully.';

        messageElement.className =
            'message success';

        form.reset();

        if (type === 'CASE') {

            document.getElementById('personsContainer')
                .innerHTML = '';

            document.getElementById('locationsContainer')
                .innerHTML = '';

            document.getElementById('phonesContainer')
                .innerHTML = '';

            document.getElementById('vehiclesContainer')
                .innerHTML = '';
        }

        await loadRecords();

    } catch (error) {

        console.error(error);

        messageElement.textContent =
            error.message || 'Something went wrong.';

        messageElement.className =
            'message error';
    }
});

loadRecords();

</script>

