<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        User Login | Criminet
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            min-height: 100vh;

            display: flex;

            align-items: center;
            justify-content: center;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #020617;

            color: white;
        }


        .container {

            width: 100%;

            max-width: 430px;

            padding: 20px;
        }


        .card {

            padding: 35px;

            border:
                1px solid #1e293b;

            border-radius: 15px;

            background: #0f172a;

            box-shadow:
                0 25px 70px
                rgba(0, 0, 0, .45);
        }


        .logo {

            width: 55px;
            height: 55px;

            display: flex;

            align-items: center;
            justify-content: center;

            margin-bottom: 22px;

            border-radius: 13px;

            background: #1e293b;

            font-size: 20px;

            font-weight: 800;
        }


        h1 {

            margin:
                0 0 8px;

            font-size: 28px;
        }


        .subtitle {

            margin:
                0 0 28px;

            color: #64748b;

            line-height: 1.5;
        }


        .error {

            margin-bottom: 20px;

            padding: 12px 14px;

            border:
                1px solid #7f1d1d;

            border-radius: 8px;

            background: #450a0a;

            color: #fecaca;

            font-size: 13px;
        }


        label {

            display: block;

            margin:
                16px 0 7px;

            color: #cbd5e1;

            font-size: 13px;

            font-weight: 600;
        }


        input {

            width: 100%;

            padding: 13px 14px;

            border:
                1px solid #334155;

            border-radius: 8px;

            outline: none;

            background: #020617;

            color: white;

            font-size: 15px;
        }


        input:focus {

            border-color: #64748b;
        }


        button {

            width: 100%;

            margin-top: 24px;

            padding: 13px;

            border: none;

            border-radius: 8px;

            background: white;

            color: #020617;

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;
        }


        button:hover {

            background: #e2e8f0;
        }


        .back {

            display: block;

            margin-top: 22px;

            text-align: center;

            color: #64748b;

            font-size: 13px;

            text-decoration: none;
        }


        .back:hover {

            color: #cbd5e1;
        }


        .admin {

            margin-top: 12px;

            text-align: center;

            font-size: 12px;

            color: #475569;
        }


        .admin a {

            color: #94a3b8;

            text-decoration: none;
        }

    </style>

</head>


<body>


<div class="container">


    <div class="card">


        <div class="logo">
            CI
        </div>


        <h1>
            User Login
        </h1>


        <p class="subtitle">

            Sign in to access the Criminal
            Intelligence Investigation System.

        </p>


        <% if (error) { %>

            <div class="error">

                <%= error %>

            </div>

        <% } %>


        <form
            method="POST"
            action="/login"
        >


            <label for="username">
                Username
            </label>


            <input
                id="username"
                type="text"
                name="username"
                placeholder="Enter username"
                autocomplete="username"
                required
                autofocus
            >


            <label for="password">
                Password
            </label>


            <input
                id="password"
                type="password"
                name="password"
                placeholder="Enter password"
                autocomplete="current-password"
                required
            >


            <button type="submit">
                Sign In
            </button>


        </form>


        <a
            class="back"
            href="/"
        >
            ← Back to home
        </a>


        <div class="admin">

            Administrator?

            <a href="/admin">
                Admin Login
            </a>

        </div>


    </div>


</div>


</body>

</html>